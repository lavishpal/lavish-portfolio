# ---------------------------------------------------------------------------
# lavish-portfolio — environment variables
#
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------

# "development" locally, "production" on your host.
NODE_ENV=development

# Public origin the app is served from. Better Auth uses it as its baseURL, so
# it must match the URL you actually open in the browser.
# IMPORTANT: no trailing slash.
WEBSITE_URL=http://localhost:4200

# Port the Bun/Hono server listens on in production (`bun run start`).
# Locally the Vite dev server owns the port from .runable/ports.json (4200).
PORT=4200

# --- Admin allowlist ---------------------------------------------------------

# Comma-separated list of emails allowed into /admin. Anyone signed in with an
# email outside this list gets a 403 from every admin procedure. Enforced
# server-side only (packages/web/src/api/middleware/auth.ts) — never in the
# frontend bundle.
ADMIN_EMAILS=lavishpal408@gmail.com

# --- Database (Turso / libSQL) ----------------------------------------------

# libSQL connection string for the blog database.
#   Turso cloud:   libsql://<db-name>-<org>.turso.io
#   Local file:    file:./local.db
DATABASE_URL=

# Turso auth token for DATABASE_URL. Leave empty for a local file: database.
# Create with: turso db tokens create <db-name>
DATABASE_AUTH_TOKEN=

# --- Authentication (Better Auth) -------------------------------------------

# Signing secret for sessions and tokens. Generate a fresh 32+ byte value:
#   openssl rand -base64 32
# Rotating this invalidates every existing session.
BETTER_AUTH_SECRET=

# --- Object storage (S3-compatible, for admin image uploads) -----------------
# Cover images and inline images uploaded from the admin editor land here.
# Any S3-compatible provider works (Cloudflare R2, AWS S3, Backblaze B2).
# The bucket stays private: the API serves objects via short-lived presigned
# URLs at /api/media/<key>.

# e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Optional: Runable platform integrations ---------------------------------
# Only needed if you keep the features that use them. The app runs without
# these: the blog, admin, and galaxy background do not touch them.

# OpenAI-compatible AI gateway (unused by the current feature set).
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Autumn billing key (unused by the current feature set).
AUTUMN_SECRET_KEY=

# Runable app identity + analytics. Safe to leave empty outside Runable.
APPLICATION_ID=
RUNABLE_URL=
VITE_APPLICATION_ID=
VITE_RUNABLE_AUTH_ISSUER=
